# ---------------------------------------------------------------------------
# VisiQ settings. Copy this file to ".env" and fill in the values.
# Never share the .env file and never commit it to GitHub.
# ---------------------------------------------------------------------------

# --- Supabase database -------------------------------------------------------
# Supabase dashboard > Connect > "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth (staff sign-in) ---------------------------------------------
# Supabase dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key-here
# SECRET. Server only. Never put this in the browser or in GitHub.
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-or-secret-key-here

# --- First start --------------------------------------------------------------
# 1 = fill the system with demo hospital data (good for trying it out)
# 0 = real use: creates only the settings and ONE administrator
VISIQ_DEMO=1
# small = a quick demo (about 6 minutes on a faraway database). Leave empty for the full demo (10 to 25 minutes).
VISIQ_DEMO_SIZE=small
# Used only when VISIQ_DEMO=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
HOSPITAL_NAME=My Hospital

# --- Server -------------------------------------------------------------------
PORT=3000
# Staff are signed in as username@this-domain inside Supabase Auth. Any domain you like.
VISIQ_EMAIL_DOMAIN=visiq.example.com
# Turn these on when VisiQ is served over HTTPS (it should be, in real use).
COOKIE_SECURE=0
# Set to 1 if VisiQ runs behind a proxy such as Nginx, Render or Railway.
TRUST_PROXY=0
# Optional. If empty, one is generated and saved in the database.
SESSION_SECRET=
